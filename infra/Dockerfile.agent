FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/agent
COPY agent/pyproject.toml ./
COPY agent/src ./src
COPY agent/alembic.ini ./alembic.ini
COPY agent/migrations ./migrations

RUN pip install --no-cache-dir . \
    && mkdir -p /app/agent/artifacts/generated

RUN useradd --create-home --uid 10001 lexguard
USER lexguard

EXPOSE 8000
ENTRYPOINT ["lexguard"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
