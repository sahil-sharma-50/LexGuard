ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
OPENAI_API_KEY=your_openai_api_key

# Docker Compose overrides DATABASE_URL with the postgres service URL.
DATABASE_URL=postgresql+psycopg://localhost/lexguard

# Use development for local work. Competition requires a fresh paper account.
LEXGUARD_ENVIRONMENT=development
LEXGUARD_ENTRY_ENABLED=false

# Alpaca MCP server endpoint for native development. Docker Compose overrides
# this to http://mcp:8010/mcp.
LEXGUARD_MCP_URL=http://127.0.0.1:8010/mcp

# Options quote feed. indicative is Alpaca's free derived feed. opra requires
# the appropriate subscription. The choice is recorded as provenance.
LEXGUARD_OPTION_FEED=indicative

# Maximum accepted bid-ask width per leg.
LEXGUARD_MAX_QUOTE_WIDTH=0.40

# Competition baseline used to anchor the drawdown floor.
LEXGUARD_COMPETITION_BASELINE=100000

# Hash-verified forecast artifact written by lexguard seed-forecast.
LEXGUARD_FORECAST_ARTIFACT_PATH=artifacts/generated/forecast-SPY.json

# Underlying evaluated by the scheduler when rotation is not configured.
LEXGUARD_UNDERLYING=SPY
# Optional scheduler rotation. The sequence is evaluated by decision window.
LEXGUARD_UNDERLYING_ROTATION=SPY,QQQ,IWM,SPY
LEXGUARD_ALLOWED_SIDES=BOTH
LEXGUARD_MAX_ENTRIES_PER_DAY=3

# Operator token for authenticated stop-only control endpoints.
LEXGUARD_OPERATOR_TOKEN=change_me_operator_token

# Exact browser origin allowed to call the API.
LEXGUARD_ALLOWED_ORIGIN=http://localhost:3000

# Browser-facing API origin. Never put credentials in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
